# Cloudflare D1 form storage. Keep the API token server-side and never prefix it with NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Private Founder Dashboard access. Use a strong unique password and a random secret of at least 32 characters.
FOUNDER_DASHBOARD_PASSWORD=
FOUNDER_SESSION_SECRET=
