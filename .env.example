# Cloudflare D1 form storage. Keep the API token server-side and never prefix it with NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Private founder dashboard authentication. Keep these server-side in Vercel.
FOUNDER_EMAIL=
FOUNDER_PASSWORD=
# Generate a random secret with at least 32 characters; e.g. openssl rand -base64 48
FOUNDER_SESSION_SECRET=
